{
  "name": "enjanga-core-setup",
  "version": "1.0.41",
  "description": "Shared Carbon foundations, Sass utilities, and theme assets for Enjanga interfaces.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "style": "src/styles/index.scss",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.js"
    },
    "./styles": {
      "sass": "./src/styles/index-no-fonts.scss",
      "default": "./src/styles/index-no-fonts.scss"
    },
    "./styles-with-fonts": {
      "sass": "./src/styles/index.scss",
      "default": "./src/styles/index.scss"
    },
    "./styles-breakpoint": {
      "sass": "./styles-breakpoint.scss",
      "default": "./styles-breakpoint.scss"
    },
    "./styles-colors": {
      "sass": "./styles-colors.scss",
      "default": "./styles-colors.scss"
    },
    "./styles-spacing": {
      "sass": "./styles-spacing.scss",
      "default": "./styles-spacing.scss"
    },
    "./styles-type": {
      "sass": "./styles-type.scss",
      "default": "./styles-type.scss"
    },
    "./carbon-css": {
      "import": "./dist/styles-no-fonts.min.css",
      "require": "./dist/styles-no-fonts.min.css"
    },
    "./carbon-css-with-fonts": {
      "import": "./dist/styles.min.css",
      "require": "./dist/styles.min.css"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "*.scss",
    "src/styles",
    "dist/styles.min.css",
    "styles.scss"
  ],
  "scripts": {
    "build": "tsup && npm run build-css",
    "build-css": "npm run copy-carbon-css && npm run build-carbon-css-no-fonts",
    "copy-carbon-css": "cp node_modules/@carbon/styles/css/styles.min.css dist/styles.min.css",
    "build-carbon-css-no-fonts": "sass --load-path=node_modules src/styles/carbon-no-fonts-minimal.scss dist/styles-no-fonts.min.css --style=compressed --no-source-map",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run type-check",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist",
    "release": "npm version patch && npm publish"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.67.0",
    "@carbon/react": "^1.91.0",
    "@carbon/styles": "^1.90.0",
    "@carbon/themes": "^11.80.0",
    "sass": "^1.94.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "next": "^15.5.7",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.7.1",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "keywords": [
    "carbon",
    "design-system",
    "react",
    "nextjs",
    "components",
    "ibm"
  ],
  "author": "Enjanga <contact@enjanga.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ericnjanga/enjanga-core-setup.git"
  },
  "bugs": {
    "url": "https://github.com/ericnjanga/enjanga-core-setup/issues"
  },
  "homepage": "https://github.com/ericnjanga/enjanga-core-setup#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ]
}
